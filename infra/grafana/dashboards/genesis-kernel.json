{
  "title": "Genesis Kernel",
  "uid": "genesis-kernel",
  "schemaVersion": 36,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Queue Depth",
      "targets": [
        {"expr": "genesis_queue_depth"}
      ],
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Job Duration P95",
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(genesis_job_duration_seconds_bucket[5m])) by (le))"}
      ],
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Jobs Completed",
      "targets": [
        {"expr": "sum(rate(genesis_jobs_completed_total[5m])) by (status)"}
      ],
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 9}
    }
  ]
}
